__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
.matplotlib/

# Raw mirror of the JORT OCR corpus (~6.4k gzipped issues, re-downloadable
# with `python -m eltn.cli harvest`). Never committed.
# Excluded as `/*` rather than `/` so that individual files below can be
# re-included: git does not descend into an excluded directory, so a negation
# inside one never fires.
data/raw/*
data/interim/

# Local tooling only (used to preview the explorer)
node_modules/
package.json
package-lock.json

# --- multiplex-2008-2012 build ---------------------------------------------
# The manifest is kept: it carries a sha256 per mirrored issue, which is what
# makes the raw layer verifiable without redistributing it.
!data/raw/manifest.csv

# Python tooling for this build
*.py[cod]
.pytest_cache/
*.egg-info/
*.tmp
.DS_Store

# Large derived artifacts. Committed gzipped instead (see *.gz alongside), or
# rebuilt from the committed CSVs with `make extract && make export`.
data/processed/multiplex-2008-2012/events.csv
data/processed/multiplex-2008-2012/blocks_index.csv
data/processed/multiplex-2008-2012/resolution.csv
data/processed/multiplex-2008-2012/panel_edges_monthly.csv
data/processed/multiplex-2008-2012/gazette_only_persons.csv
data/processed/multiplex-2008-2012/elitenet.sqlite
data/processed/multiplex-2008-2012/exports/elite_network_full.gexf

# --- bourse component -------------------------------------------------------
# Source PDFs from the CMF (~1.9 GB). data/raw/ is already ignored above; this
# is a reminder of what lives there and how to get it back:
#   make bourse-resolve bourse-fetch
# The corpus manifest under data/processed/bourse/corpus/ carries the canonical
# URL and a sha256 per file, so the corpus is reconstructible and verifiable
# without redistributing CMF documents.
#
# Network exports are derived from the committed edge lists and regenerate in
# seconds with `make bourse-export`.
data/processed/bourse/graphml/
data/processed/bourse/graphml_panel/
data/processed/bourse/muxviz/
data/processed/bourse/muxviz_panel/

# --- aalam-tunisiyun --------------------------------------------------------
# The scanned volume (~12 MB) and the per-page OCR images are not
# redistributed. data/raw/ is already ignored above; the page text and the
# manifest are the exceptions, and they are deliberate:
#
#   manifest.csv   carries a sha256 per page, which is what makes the raw
#                  layer verifiable without shipping the book;
#   pages/*.txt    are committed (~455 KB) so that CI can rebuild the tables
#                  and byte-diff them without installing an OCR engine, and so
#                  the verbatim-quote guard can run on every row in CI.
!data/raw/aalam/
data/raw/aalam/*
!data/raw/aalam/manifest.csv
!data/raw/aalam/pages/
data/raw/aalam/pages/*
!data/raw/aalam/pages/*.txt
data/interim/aalam/
